# Local development needs no credentials. Data lives in .odin/vault.
ODIN_STORAGE=local
# Optional custom local vault directory (never set a public folder).
# ODIN_VAULT_DIR=
ODIN_SEED_EXAMPLES=1

# Conversation import uses your existing AI. No AI API key or automatic AI billing.
# The companion CLI connects to this Odin URL (default below).
# ODIN_URL=http://127.0.0.1:3000
# Local Codex source: enabled on development loopback. Set 0 to disable.
# Production requires explicit 1 and still only accepts loopback requests.
# ODIN_CODEX_IMPORT_ENABLED=0
# Optional alternate Codex history root. Never expose this through request parameters.
# ODIN_CODEX_HOME=

# REQUIRED before hosting publicly. Generate independent random secrets.
# Do not use these commented placeholders as real values.
# ODIN_OWNER_PASSWORD=
# ODIN_SESSION_SECRET=
# ODIN_API_TOKEN=

# Google Drive (switch ODIN_STORAGE to drive once configured).
# Use an OAuth desktop client, then npm run setup:drive.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=

# Optional OAuth resource server for remote AI clients.
# Connect your own authorization server; all three fields must be set.
# ODIN_OAUTH_ISSUER=
# ODIN_OAUTH_AUDIENCE=
# ODIN_OAUTH_OWNER_SUB=
# ODIN_PUBLIC_URL=

# Required for Drive writes on Vercel: shared write coordination only.
# ODIN_LOCK_REDIS_URL=
# ODIN_LOCK_REDIS_TOKEN=
